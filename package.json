{
  "name": "soccer-runs",
  "private": true,
  "type": "module",
  "scripts": {
    "discord:invite-bot": "node --env-file=.env scripts/setup-discord.mjs invite-bot",
    "discord:setup": "node --env-file=.env scripts/setup-discord.mjs setup",
    "discord:organizer": "node --env-file=.env scripts/setup-discord.mjs organizer",
    "discord:commands": "node --env-file=.env scripts/register-commands.mjs",
    "db:migrate": "node --env-file=.env.vercel scripts/migrate.mjs",
    "typecheck": "tsc",
    "extension:zip": "rm -f public/booker/sory-booker.zip && cd extension && zip -qr ../public/booker/sory-booker.zip manifest.json booker.js"
  },
  "dependencies": {
    "@vercel/functions": "^3.11.3",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
